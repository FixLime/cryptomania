# ===== Database =====
DATABASE_URL=postgresql://crypto:crypto@localhost:5432/cryptomania

# ===== Backend =====
PORT=3000
NODE_ENV=development
# 32-байтный hex ключ (openssl rand -hex 32) — НЕ МЕНЯТЬ ПОСЛЕ ЗАПУСКА В ПРОДЕ
MASTER_ENCRYPTION_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff
# Лимит автоматического вывода (выше — ручное одобрение админа), в USD
WITHDRAWAL_AUTO_APPROVE_LIMIT_USD=100

# ===== TON =====
