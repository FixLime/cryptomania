generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  FROZEN
  BANNED
}

enum KycStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum Currency {
  TON
  USDT_TON
  USDT_TRC20
  ETH
  BTC
}

enum TxType {
  DEPOSIT
  WITHDRAWAL
  INTERNAL_IN
  INTERNAL_OUT
  SWAP_IN
  SWAP_OUT
  FEE
  BONUS
}

enum TxStatus {
  PENDING
  AWAITING_APPROVAL
  APPROVED
  REJECTED
  BROADCASTING
  CONFIRMED
  FAILED
}

model User {
  id              String     @id @default(cuid())
  telegramId      String     @unique
  username        String?
  firstName       String?
  lastName        String?
  languageCode    String?
  status          UserStatus @default(ACTIVE)
  kycStatus       KycStatus  @default(NONE)
  isAdmin         Boolean    @default(false)
  pinHash         String?
  fiatCurrency    String     @default("USD")
  hideBalances    Boolean    @default(false)
  notifyDeposits  Boolean    @default(true)
  notifyWithdrawals Boolean  @default(true)
  referralCode    String     @unique @default(cuid())
  referredById    String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  wallets         Wallet[]
  transactions    Transaction[]
  kycSubmissions  KycSubmission[]
  auditLogs       AuditLog[]   @relation("ActorLogs")
  targetedLogs    AuditLog[]   @relation("TargetLogs")
  addressBook     AddressBookEntry[]
  referredBy      User?        @relation("Referrals", fields: [referredById], references: [id])
  referrals       User[]       @relation("Referrals")

  @@index([status])
  @@index([username])
}

model Wallet {
  id                  String   @id @default(cuid())
  userId              String
  currency            Currency
  address             String
  encryptedPrivateKey String?
  derivationPath      String?
  balance             Decimal  @default(0) @db.Decimal(40, 18)
  lockedBalance       Decimal  @default(0) @db.Decimal(40, 18)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions        Transaction[]

  @@unique([userId, currency])
  @@unique([currency, address])
  @@index([address])
}

model Transaction {
  id              String    @id @default(cuid())
  userId          String
  walletId        String
  type            TxType
  status          TxStatus  @default(PENDING)
  currency        Currency
  amount          Decimal   @db.Decimal(40, 18)
  fee             Decimal   @default(0) @db.Decimal(40, 18)
  fromAddress     String?
  toAddress       String?
  // Для INTERNAL_*: ID контрагента
  counterpartyUserId String?
  // Для SWAP_*: ID парной транзакции
  pairedTxId      String?
  txHash          String?   @unique
  blockNumber     BigInt?
  confirmations   Int       @default(0)
  approvedById    String?
  rejectedReason  String?
  note            String?
  metadata        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id])
  wallet          Wallet    @relation(fields: [walletId], references: [id])

  @@index([userId, createdAt])
  @@index([status])
  @@index([txHash])
}

model KycSubmission {
  id            String    @id @default(cuid())
  userId        String
  status        KycStatus @default(PENDING)
  fullName      String
  documentType  String
  documentNumber String
  documentPhotoPath String
  selfiePhotoPath   String
  reviewedById  String?
  reviewedAt    DateTime?
  rejectReason  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

model AddressBookEntry {
  id        String   @id @default(cuid())
  userId    String
  label     String
  currency  Currency
  address   String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  targetUserId String?
  action       String
  entityType   String?
  entityId     String?
  metadata     Json?
  ip           String?
  createdAt    DateTime @default(now())

  actor        User?    @relation("ActorLogs", fields: [actorId], references: [id])
  targetUser   User?    @relation("TargetLogs", fields: [targetUserId], references: [id])

  @@index([actorId, createdAt])
  @@index([action])
}
